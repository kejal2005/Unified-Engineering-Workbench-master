{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Build Release",
      "type": "shell",
      "command": "cmake --build --preset release",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "CMake: Build Debug",
      "type": "shell",
      "command": "cmake --build --preset debug",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "CTest: Run Tests",
      "type": "shell",
      "command": "ctest --preset release --output-on-failure",
      "group": "test"
    }
  ]
}

